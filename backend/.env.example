# Backend configuration (copy to backend/.env for local runs). No secrets are committed.
AAWEN_ENV=development            # development | test | production
DEBUG=true
SECRET_KEY=                      # REQUIRED in production (>= 50 random chars)
DATABASE_URL=postgis://aawen:devpass@localhost:5432/aawen
REDIS_URL=redis://localhost:6379/0
CACHE_URL=redis://localhost:6379/1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173

# Media storage (S3-compatible: AWS S3, Cloudflare R2, MinIO, Wasabi...)
USE_S3=false
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# SMS for login codes: console (dev simulator) | http (provider) | disabled
SMS_PROVIDER=console
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER_ID=AAWEN

# Push notifications: simulated | fcm | disabled
PUSH_PROVIDER=simulated
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=

# AI assist (optional, advisory only): local | anthropic
AI_PROVIDER=local
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
TRANSCRIPTION_PROVIDER=none      # none | simulated | http
TRANSCRIPTION_HTTP_URL=

# Payments: disabled (production default) | simulated (dev) | live (needs ALL of the below + written authorisation)
PAYMENTS_MODE=simulated
PAYMENT_PROVIDER=simulator       # simulator | generic_http
PAYMENT_WEBHOOK_SECRET=
PAYMENT_HTTP_BASE_URL=
PAYMENT_HTTP_API_KEY=
PAYMENT_BENEFICIARY_CONFIGURED=false
PAYMENT_LIVE_AUTHORISED=false
PLATFORM_FEE_PERCENT=0

DEMO_DATA_ALLOWED=true           # demo seeding is always refused when AAWEN_ENV=production
BACKUP_DIR=
LOG_LEVEL=INFO
